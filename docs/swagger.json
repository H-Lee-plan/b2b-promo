{
  "openapi": "3.0.3",
  "info": {
    "title": "온리원이벤트 API",
    "version": "1.0.0",
    "description": "식자재 유통 B2B 고객사 대상 이벤트 참여 웹앱 \"온리원이벤트\"의 REST API 명세.\n이 문서는 PRD v1.4 3절의 P0 범위(FR-1.0~FR-1.11)만 다룬다. 마이페이지, 참여신청 취소/재신청, 폼 제출형(FORM) 이벤트, 동의 보유 내용 작성, 로그인 rate limit, 이벤트 삭제/엑셀 다운로드 등 P1(FR-2.x) 기능은 포함하지 않는다.\n인증은 쿠키를 사용하지 않으며(PRD 4절), Access/Refresh Token을 모두 요청/응답 바디로 주고받는다."
  },
  "servers": [
    { "url": "/api", "description": "동일 오리진 API 베이스 경로" }
  ],
  "tags": [
    { "name": "Auth", "description": "회원가입/로그인/토큰 재발급/로그아웃 (authRoutes)" },
    { "name": "Events", "description": "이벤트 조회/등록/수정/종료 (eventsRoutes)" },
    { "name": "Entries", "description": "참여신청 생성 및 목록 조회 (entriesRoutes)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access Token(JWT, 만료 1시간)을 `Authorization: Bearer <accessToken>` 헤더로 전달한다. 쿠키 인증은 사용하지 않는다(PRD 4절)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "모든 4xx/5xx 응답 공통 포맷(PRD 4절).",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "에러 코드. 도메인 비즈니스 규칙 위반 시 아래 6종 중 하나를 사용한다: DUPLICATE_ENTRY(중복 참여신청), TARGET_TYPE_MISMATCH(참여 대상 유형 불일치), EVENT_CLOSED(종료된 이벤트), CONSENT_REQUIRED(개인정보 미동의), VALIDATION_ERROR(입력값 검증 실패, 인증 실패/권한 없음 등 그 외 4xx 포함), INTERNAL_ERROR(예상하지 못한 서버 오류).",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "description": "사용자 노출용 에러 문구",
                "example": "입력값을 확인해주세요."
              }
            }
          }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": ["ADMIN", "MEMBER"],
        "description": "관리자 / 일반 참여자"
      },
      "TargetType": {
        "type": "string",
        "enum": ["MEMBER_ONLY", "GUEST_ONLY", "COMMON"],
        "description": "참여 대상 유형: 회원 전용 / 비회원 전용 / 공통"
      },
      "ParticipationType": {
        "type": "string",
        "enum": ["SIMPLE", "FORM", "ROULETTE"],
        "description": "참여 방식: 단순 참여 / 폼 제출형(P1, 이 문서 범위 밖) / 룰렛 게임형. 이 스펙(P0)은 SIMPLE, ROULETTE만 다룬다."
      },
      "EventStatus": {
        "type": "string",
        "enum": ["SCHEDULED", "ONGOING", "CLOSED"],
        "description": "이벤트 상태: 등록 / 진행중 / 종료. 조회 시점에 startAt/endAt과 현재 시각을 비교해 lazy 계산된다."
      },
      "EntryStatus": {
        "type": "string",
        "enum": ["APPLIED", "CANCELED", "WON", "LOST"],
        "description": "참여신청 상태: 신청완료 / 취소(P1 기능으로만 전환) / 당첨 / 미당첨. 당첨·미당첨은 룰렛 게임형에서만 사용."
      },
      "User": {
        "type": "object",
        "description": "회원(관리자/일반 참여자). 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "email": { "type": "string", "format": "email" },
          "companyName": { "type": "string" },
          "name": { "type": "string" },
          "phone": { "type": "string", "description": "숫자·하이픈, 국내 휴대전화 형식", "example": "010-1234-5678" }
        }
      },
      "Prize": {
        "type": "object",
        "description": "룰렛 게임형(participationType=ROULETTE) 이벤트에만 존재하는 경품 후보. 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "description": "경품명(꽝인 경우 \"미당첨\"으로 등록)" },
          "weight": { "type": "integer", "minimum": 1, "description": "당첨 가중치(1 이상 정수)" }
        }
      },
      "PrizeInput": {
        "type": "object",
        "required": ["name", "weight"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "integer", "minimum": 1 }
        }
      },
      "Event": {
        "type": "object",
        "description": "이벤트. 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "targetType": { "$ref": "#/components/schemas/TargetType" },
          "participationType": { "$ref": "#/components/schemas/ParticipationType" },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": "string", "format": "date-time" },
          "isPinned": { "type": "boolean", "description": "상단 노출(강조) 설정 여부" },
          "status": { "$ref": "#/components/schemas/EventStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "prizes": {
            "type": "array",
            "description": "participationType=ROULETTE인 경우에만 채워진다. 그 외 참여 방식은 빈 배열.",
            "items": { "$ref": "#/components/schemas/Prize" }
          }
        }
      },
      "EventCreateRequest": {
        "type": "object",
        "required": ["title", "targetType", "participationType", "startAt", "endAt", "isPinned"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "targetType": { "$ref": "#/components/schemas/TargetType" },
          "participationType": {
            "type": "string",
            "enum": ["SIMPLE", "ROULETTE"],
            "description": "이 스펙(P0)에서는 SIMPLE, ROULETTE만 등록 가능. FORM(폼 제출형)은 P1 범위."
          },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": "string", "format": "date-time" },
          "isPinned": { "type": "boolean" },
          "prizes": {
            "type": "array",
            "description": "participationType=ROULETTE일 때 필수(1건 이상 있어야 진행중 상태로 전환 가능, 도메인 정의서 6절). SIMPLE이면 생략.",
            "items": { "$ref": "#/components/schemas/PrizeInput" }
          }
        }
      },
      "EventUpdateRequest": {
        "type": "object",
        "description": "이벤트 수정 요청. 등록(SCHEDULED) 상태에서는 모든 필드를 자유롭게 수정할 수 있으나, 진행중(ONGOING) 상태에서는 targetType/participationType/startAt을 변경할 수 없고 endAt은 연장만 허용된다(도메인 정의서 6절).",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "targetType": { "$ref": "#/components/schemas/TargetType" },
          "participationType": { "$ref": "#/components/schemas/ParticipationType" },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": "string", "format": "date-time" },
          "isPinned": { "type": "boolean" },
          "prizes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PrizeInput" }
          }
        }
      },
      "Entry": {
        "type": "object",
        "description": "참여신청. 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid", "nullable": true, "description": "회원 참여자인 경우 회원 ID(비회원이면 null)" },
          "guestEmail": { "type": "string", "format": "email", "nullable": true, "description": "비회원 참여자 식별 정보(trim+소문자 정규화 저장). 회원이면 null" },
          "guestPhone": { "type": "string", "nullable": true },
          "guestInfo": { "type": "object", "nullable": true, "description": "비회원 참여 시 입력한 업체명/이름/연락처 등" },
          "formData": { "type": "object", "nullable": true, "description": "폼 제출형(FORM, P1) 전용 필드. 이 스펙(P0) 범위에서는 항상 null." },
          "consentedAt": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/EntryStatus" },
          "prizeId": { "type": "string", "format": "uuid", "nullable": true, "description": "룰렛 게임형에서 확정된 경품 참조" },
          "prize": {
            "allOf": [{ "$ref": "#/components/schemas/Prize" }],
            "nullable": true,
            "description": "룰렛 게임형 확정 결과의 경품 상세(참여신청 생성/목록 응답 편의 필드)"
          },
          "appliedAt": { "type": "string", "format": "date-time" },
          "consentNote": { "type": "string", "nullable": true, "description": "관리자가 사후 작성하는 개인정보 동의 보유 내용(P1, FR-2.4). 이 스펙 범위에서는 항상 null." }
        }
      },
      "EntryCreateRequest": {
        "type": "object",
        "required": ["consent"],
        "description": "참여신청 생성 요청. Authorization 헤더가 있으면 회원 참여로 처리되어 guestEmail/guestPhone/guestInfo는 무시된다. 없으면 비회원 참여로 처리되며 guestEmail/guestPhone/guestInfo가 필수다.",
        "properties": {
          "consent": {
            "type": "boolean",
            "description": "개인정보 동의 여부(회원: 개인정보 사용 동의, 비회원: 개인정보 수집·이용 및 보유기간 동의). true가 아니면 CONSENT_REQUIRED로 거부된다."
          },
          "guestEmail": { "type": "string", "format": "email", "description": "비회원 참여 시 필수. 동일 인물 판단 기준(trim+소문자 정규화 후 비교)" },
          "guestPhone": { "type": "string", "description": "비회원 참여 시 필수. 숫자·하이픈, 국내 휴대전화 형식" },
          "guestInfo": {
            "type": "object",
            "description": "비회원 참여 시 필수. 업체명/이름/연락처 등",
            "properties": {
              "companyName": { "type": "string" },
              "name": { "type": "string" },
              "phone": { "type": "string" }
            }
          }
        }
      },
      "EntryListItem": {
        "allOf": [
          { "$ref": "#/components/schemas/Entry" },
          {
            "type": "object",
            "properties": {
              "user": {
                "allOf": [{ "$ref": "#/components/schemas/User" }],
                "nullable": true,
                "description": "회원 참여 건인 경우 회원 정보(비회원이면 null)"
              }
            }
          }
        ]
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "companyName", "name", "phone"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "원문 비밀번호, 최소 8자 이상(서버가 bcrypt로 해시하여 저장)"
          },
          "companyName": { "type": "string" },
          "name": { "type": "string" },
          "phone": { "type": "string", "example": "010-1234-5678" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string", "description": "JWT Access Token(만료 1시간)" },
          "refreshToken": { "type": "string", "description": "JWT Refresh Token(만료 14일)" }
        }
      },
      "LoginResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/TokenPair" },
          {
            "type": "object",
            "properties": {
              "user": { "$ref": "#/components/schemas/User" }
            }
          }
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string", "description": "폐기할 Refresh Token" }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입(일반 참여자)",
        "description": "일반 참여자 계정을 생성한다(FR-1.1). 관리자 계정은 이 API로 생성되지 않는다(도메인 1절, 시딩으로만 생성). role은 서버가 MEMBER로 고정한다. email은 trim+소문자로 정규화한 값 기준으로 중복 검사한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": {
            "description": "입력값 검증 실패(이메일 형식 오류, 비밀번호 8자 미만, 이미 가입된 이메일)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인(관리자·일반 참여자 공통)",
        "description": "이메일/비밀번호로 로그인하여 Access/Refresh Token을 응답 바디로 발급받는다(FR-1.2). 쿠키(Set-Cookie)를 사용하지 않는다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } }
            }
          },
          "401": {
            "description": "이메일 또는 비밀번호 불일치(어느 쪽이 틀렸는지 구분해 알려주지 않는다)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Access/Refresh Token 재발급",
        "description": "Refresh Token을 검증하고 회전(기존 토큰 삭제 후 신규 발급)하여 새 Access/Refresh Token 쌍을 반환한다. 이미 사용되었거나 폐기된 Refresh Token은 재사용할 수 없다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TokenPair" } }
            }
          },
          "401": {
            "description": "Refresh Token이 유효하지 않거나(위조·만료) 이미 폐기/사용된 토큰",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그아웃",
        "description": "전달한 Refresh Token을 서버에서 폐기한다. 이후 해당 토큰으로 재발급을 시도하면 실패한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LogoutRequest" } }
          }
        },
        "responses": {
          "204": { "description": "로그아웃 성공(응답 바디 없음)" },
          "401": {
            "description": "유효하지 않은 Refresh Token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": ["Events"],
        "summary": "이벤트 목록 조회",
        "description": "이벤트 목록을 상단 노출(isPinned) 우선, 마감일자(endAt) 빠른 순, 동률 시 등록일시(createdAt) 빠른 순으로 정렬해 반환한다(도메인 정의서 7절). 인증이 필요 없다.",
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Event" } }
              }
            }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "post": {
        "tags": ["Events"],
        "summary": "이벤트 등록 (관리자 전용)",
        "description": "관리자(role=ADMIN) 전용. 참여 대상 유형·참여 방식·상단 노출 여부를 지정해 이벤트를 등록한다(FR-1.7). participationType이 ROULETTE이면 경품 목록(name, weight)을 함께 등록해야 하며, 경품이 1건 이상 있어야 이후 진행중 상태로 전환될 수 있다(도메인 정의서 6절).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EventCreateRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } }
          },
          "400": {
            "description": "입력값 검증 실패(필수 필드 누락, weight가 1 미만, startAt/endAt 형식 오류 등)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자(role=ADMIN)가 아닌 사용자의 접근",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/events/{eventId}": {
      "get": {
        "tags": ["Events"],
        "summary": "이벤트 상세 조회",
        "description": "이벤트 1건의 상세 정보를 조회한다. status는 현재 시각과 startAt/endAt을 비교한 lazy 계산 결과다. 인증이 필요 없다.",
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } }
          },
          "404": {
            "description": "존재하지 않는 이벤트",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "patch": {
        "tags": ["Events"],
        "summary": "이벤트 수정 (관리자 전용)",
        "description": "관리자(role=ADMIN) 전용. 등록(SCHEDULED) 상태에서는 모든 필드를 자유롭게 수정할 수 있다. 진행중(ONGOING) 상태에서는 targetType/participationType/startAt을 변경할 수 없고, endAt은 연장(현재 값보다 늦은 시각)만 허용된다(도메인 정의서 6절). 종료(CLOSED) 상태의 이벤트는 수정할 수 없다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EventUpdateRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } }
          },
          "400": {
            "description": "입력값 검증 실패 또는 진행중 상태에서 수정 불가 필드(targetType/participationType/startAt) 변경 시도, endAt 단축 시도, 종료된 이벤트 수정 시도",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자(role=ADMIN)가 아닌 사용자의 접근",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않는 이벤트",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/events/{eventId}/close": {
      "post": {
        "tags": ["Events"],
        "summary": "이벤트 종료 (관리자 전용)",
        "description": "관리자(role=ADMIN) 전용. 진행중(ONGOING) 이벤트를 즉시 종료(CLOSED) 상태로 전환한다(FR-1.8). 단방향 전환이며 되돌리는 API는 없다. 종료 후 해당 이벤트는 신규 참여신청을 받지 않는다(도메인 정의서 6절).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "종료 처리 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Event" } } }
          },
          "400": {
            "description": "이미 종료되었거나 아직 시작(진행중)되지 않은 이벤트에 대한 종료 요청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자(role=ADMIN)가 아닌 사용자의 접근",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않는 이벤트",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/events/{eventId}/entries": {
      "post": {
        "tags": ["Entries"],
        "summary": "참여신청 생성 (회원/비회원 공통)",
        "description": "이벤트에 참여신청을 생성한다(FR-1.4, FR-1.5, FR-1.6). **인증이 필수가 아니다**: `Authorization` 헤더에 유효한 Access Token이 있으면 회원 참여로 처리되어 별도 개인정보 입력 없이 동의만으로 신청이 성립하고, 헤더가 없으면 비회원 참여로 처리되어 guestEmail/guestPhone/guestInfo가 필수다. participationType=ROULETTE인 이벤트는 같은 트랜잭션 내에서 서버가 경품을 weight 가중치 기반으로 즉시 확정하며(재추첨 불가), 응답의 prize/prizeId/status(WON 또는 LOST)에 결과가 담긴다. (이벤트, 참여자) 조합당 1건만 허용되며, 취소(CANCELED) 상태였던 기존 레코드가 있으면 새 레코드 없이 재신청으로 전환된다(도메인 정의서 5·6절).",
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EntryCreateRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "참여신청 성공(단순 참여는 status=APPLIED, 룰렛 게임형은 status=WON/LOST와 확정 경품 포함)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Entry" } } }
          },
          "400": {
            "description": "개인정보 미동의(CONSENT_REQUIRED) 또는 입력값 검증 실패(VALIDATION_ERROR: 비회원 필수 항목 누락, 이메일/연락처 형식 오류 등)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "이벤트의 참여 대상 유형(targetType)과 참여자 유형이 일치하지 않음(TARGET_TYPE_MISMATCH). 예: 회원 전용 이벤트에 비회원 참여 시도, 비회원 전용 이벤트에 회원 토큰으로 참여 시도",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않는 이벤트",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "409": {
            "description": "이미 신청완료/당첨/미당첨 상태인 (이벤트, 참여자) 조합의 중복 신청(DUPLICATE_ENTRY), 또는 이미 종료된 이벤트에 대한 신규/재신청 시도(EVENT_CLOSED)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "get": {
        "tags": ["Entries"],
        "summary": "이벤트별 참여신청 목록 조회 (관리자 전용)",
        "description": "관리자(role=ADMIN) 전용. 특정 이벤트의 참여신청 목록을 신청 시각 순으로 조회한다(FR-1.9). 회원/비회원 참여 건이 모두 포함되며 구분 가능하다. 참여신청이 0건이면 빈 배열을 반환한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "조회 성공(0건이어도 200 + 빈 배열)",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/EntryListItem" } }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자(role=ADMIN)가 아닌 사용자의 접근",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않는 이벤트",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    }
  }
}
