          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않는 계정(토큰 발급 이후 계정이 삭제된 경우)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "patch": {
        "tags": ["Mypage"],
        "summary": "본인 정보 수정",
        "description": "로그인 회원 본인의 업체명/이름/연락처를 수정한다(FR-2.1).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "400": {
            "description": "companyName/name/phone 중 누락(VALIDATION_ERROR)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/mypage/password": {
      "patch": {
        "tags": ["Mypage"],
        "summary": "본인 비밀번호 변경",
        "description": "로그인 회원 본인의 비밀번호를 변경한다(FR-2.1). 현재 비밀번호 확인 후 새 비밀번호(8자 이상)를 bcrypt로 재해시하여 저장한다.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordResponse" } } }
          },
          "400": {
            "description": "newPassword가 8자 미만이거나 currentPassword/newPassword 누락(VALIDATION_ERROR)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음, 또는 currentPassword가 실제 비밀번호와 불일치",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
