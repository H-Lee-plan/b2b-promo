{
  "openapi": "3.0.3",
  "info": {
    "title": "온리원이벤트 API",
    "version": "1.1.0",
    "description": "식자재 유통 B2B 고객사 대상 이벤트 참여 웹앱 \"온리원이벤트\"의 REST API 명세.\nFR-1.0~FR-1.11(인증, 이벤트, 참여신청)과 FR-2.1~FR-2.6(마이페이지, 참여신청 취소/재신청, 폼 제출형 이벤트, 동의 보유 내용 작성, 로그인 rate limit, 이벤트 삭제/CSV 다운로드)을 모두 포함한다.\n인증은 쿠키를 사용하지 않으며(PRD 4절), Access/Refresh Token을 모두 요청/응답 바디로 주고받는다."
  },
  "servers": [
    { "url": "/api", "description": "동일 오리진 API 베이스 경로" }
  ],
  "tags": [
    { "name": "Auth", "description": "회원가입/로그인/토큰 재발급/로그아웃 (authRoutes)" },
    { "name": "Events", "description": "이벤트 조회/등록/수정/종료/삭제 (eventsRoutes)" },
    { "name": "Entries", "description": "참여신청 생성, 목록 조회, 동의 메모 작성, CSV 다운로드 (entriesRoutes)" },
    { "name": "Mypage", "description": "회원 본인 참여 내역/정보 조회·수정, 참여신청 취소 (mypageRoutes)" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access Token(JWT, 만료 1시간)을 `Authorization: Bearer <accessToken>` 헤더로 전달한다. 쿠키 인증은 사용하지 않는다(PRD 4절)."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "모든 4xx/5xx 응답 공통 포맷(PRD 4절).",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "에러 코드. 도메인 비즈니스 규칙 위반 시 아래 7종 중 하나를 사용한다: DUPLICATE_ENTRY(중복 참여신청), TARGET_TYPE_MISMATCH(참여 대상 유형 불일치), EVENT_CLOSED(종료된 이벤트), CONSENT_REQUIRED(개인정보 미동의), EVENT_HAS_ENTRIES(참여신청이 있는 이벤트 삭제 시도), VALIDATION_ERROR(입력값 검증 실패, 로그인 rate limit 초과, 인증 실패/권한 없음 등 그 외 4xx 포함), INTERNAL_ERROR(예상하지 못한 서버 오류).",
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "description": "사용자 노출용 에러 문구",
                "example": "입력값을 확인해주세요."
              }
            }
          }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": ["ADMIN", "MEMBER"],
        "description": "관리자 / 일반 참여자"
      },
      "TargetType": {
        "type": "string",
        "enum": ["MEMBER_ONLY", "GUEST_ONLY", "COMMON"],
        "description": "참여 대상 유형: 회원 전용 / 비회원 전용 / 공통"
      },
      "ParticipationType": {
        "type": "string",
        "enum": ["SIMPLE", "FORM", "ROULETTE"],
        "description": "참여 방식: 단순 참여 / 폼 제출형(관리자가 정의한 필드 입력) / 룰렛 게임형"
      },
      "EventStatus": {
        "type": "string",
        "enum": ["SCHEDULED", "ONGOING", "CLOSED"],
        "description": "이벤트 상태: 등록 / 진행중 / 종료. 조회 시점에 startAt/endAt과 현재 시각을 비교해 lazy 계산된다."
      },
      "EntryStatus": {
        "type": "string",
        "enum": ["APPLIED", "CANCELED", "WON", "LOST"],
        "description": "참여신청 상태: 신청완료 / 취소(마이페이지 취소·재신청으로만 전환) / 당첨 / 미당첨. 당첨·미당첨은 룰렛 게임형에서만 사용."
      },
      "User": {
        "type": "object",
        "description": "회원(관리자/일반 참여자). 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "email": { "type": "string", "format": "email" },
          "companyName": { "type": "string" },
          "name": { "type": "string" },
          "phone": { "type": "string", "description": "숫자·하이픈, 국내 휴대전화 형식", "example": "010-1234-5678" }
        }
      },
      "Prize": {
        "type": "object",
        "description": "룰렛 게임형(participationType=ROULETTE) 이벤트에만 존재하는 경품 후보. 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "description": "경품명(꽝인 경우 \"미당첨\"으로 등록)" },
          "weight": { "type": "integer", "minimum": 1, "description": "당첨 가중치(1 이상 정수)" }
        }
      },
      "PrizeInput": {
        "type": "object",
        "required": ["name", "weight"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "integer", "minimum": 1 }
        }
      },
      "Event": {
        "type": "object",
        "description": "이벤트. 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "targetType": { "$ref": "#/components/schemas/TargetType" },
          "participationType": { "$ref": "#/components/schemas/ParticipationType" },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": "string", "format": "date-time" },
          "isPinned": { "type": "boolean", "description": "상단 노출(강조) 설정 여부" },
          "status": { "$ref": "#/components/schemas/EventStatus" },
          "createdAt": { "type": "string", "format": "date-time" },
          "prizes": {
            "type": "array",
            "description": "participationType=ROULETTE인 경우에만 채워진다. 그 외 참여 방식은 빈 배열.",
            "items": { "$ref": "#/components/schemas/Prize" }
          },
          "formFields": {
            "type": "array",
            "description": "participationType=FORM인 경우에만 채워지는 관리자 정의 필드명 배열(예: [\"회사명\", \"요청사항\"]). 그 외 참여 방식은 빈 배열.",
            "items": { "type": "string" }
          }
        }
      },
      "EventCreateRequest": {
        "type": "object",
        "required": ["title", "targetType", "participationType", "startAt", "endAt", "isPinned"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "targetType": { "$ref": "#/components/schemas/TargetType" },
          "participationType": { "$ref": "#/components/schemas/ParticipationType" },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": "string", "format": "date-time" },
          "isPinned": { "type": "boolean" },
          "prizes": {
            "type": "array",
            "description": "participationType=ROULETTE일 때 필수(1건 이상 있어야 진행중 상태로 전환 가능, 도메인 정의서 6절). 그 외 참여 방식이면 생략.",
            "items": { "$ref": "#/components/schemas/PrizeInput" }
          },
          "formFields": {
            "type": "array",
            "description": "participationType=FORM일 때 필수(1건 이상의 비어 있지 않은 필드명 문자열). 그 외 참여 방식이면 생략.",
            "items": { "type": "string" }
          }
        }
      },
      "EventUpdateRequest": {
        "type": "object",
        "description": "이벤트 수정 요청. 등록(SCHEDULED) 상태에서는 모든 필드를 자유롭게 수정할 수 있으나, 진행중(ONGOING) 상태에서는 targetType/participationType/startAt을 변경할 수 없고 endAt은 연장만 허용된다(도메인 정의서 6절).",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "targetType": { "$ref": "#/components/schemas/TargetType" },
          "participationType": { "$ref": "#/components/schemas/ParticipationType" },
          "startAt": { "type": "string", "format": "date-time" },
          "endAt": { "type": "string", "format": "date-time" },
          "isPinned": { "type": "boolean" },
          "prizes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PrizeInput" }
          },
          "formFields": {
            "type": "array",
            "description": "participationType=FORM일 때 필수(EventCreateRequest와 동일한 제약). 진행중(ONGOING) 상태에서는 participationType 자체를 바꿀 수 없으므로 실질적으로 SCHEDULED 상태에서만 의미가 있다.",
            "items": { "type": "string" }
          }
        }
      },
      "Entry": {
        "type": "object",
        "description": "참여신청. 도메인 정의서 4절.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid", "nullable": true, "description": "회원 참여자인 경우 회원 ID(비회원이면 null)" },
          "guestEmail": { "type": "string", "format": "email", "nullable": true, "description": "비회원 참여자 식별 정보(trim+소문자 정규화 저장). 회원이면 null" },
          "guestPhone": { "type": "string", "nullable": true },
          "guestInfo": { "type": "object", "nullable": true, "description": "비회원 참여 시 입력한 업체명/이름/연락처 등" },
          "formData": { "type": "object", "nullable": true, "description": "폼 제출형(participationType=FORM) 참여신청에서 이벤트의 formFields 각 항목에 대응하는 입력값. 그 외 참여 방식은 항상 null." },
          "consentedAt": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/EntryStatus" },
          "prizeId": { "type": "string", "format": "uuid", "nullable": true, "description": "룰렛 게임형에서 확정된 경품 참조" },
          "prize": {
            "allOf": [{ "$ref": "#/components/schemas/Prize" }],
            "nullable": true,
            "description": "룰렛 게임형 확정 결과의 경품 상세(참여신청 생성/목록 응답 편의 필드)"
          },
          "appliedAt": { "type": "string", "format": "date-time" },
          "consentNote": { "type": "string", "nullable": true, "description": "관리자가 사후 작성하는 개인정보 동의 보유 내용(FR-2.4). 작성 전에는 null." }
        }
      },
      "EntryCreateRequest": {
        "type": "object",
        "required": ["consent"],
        "description": "참여신청 생성 요청. Authorization 헤더가 있으면 회원 참여로 처리되어 guestEmail/guestPhone/guestInfo는 무시된다. 없으면 비회원 참여로 처리되며 guestEmail/guestPhone/guestInfo가 필수다.",
        "properties": {
          "consent": {
            "type": "boolean",
            "description": "개인정보 동의 여부(회원: 개인정보 사용 동의, 비회원: 개인정보 수집·이용 및 보유기간 동의). true가 아니면 CONSENT_REQUIRED로 거부된다."
          },
          "guestEmail": { "type": "string", "format": "email", "description": "비회원 참여 시 필수. 동일 인물 판단 기준(trim+소문자 정규화 후 비교)" },
          "guestPhone": { "type": "string", "description": "비회원 참여 시 필수. 숫자·하이픈, 국내 휴대전화 형식" },
          "guestInfo": {
            "type": "object",
            "description": "비회원 참여 시 필수. 업체명/이름/연락처 등",
            "properties": {
              "companyName": { "type": "string" },
              "name": { "type": "string" },
              "phone": { "type": "string" }
            }
          },
          "formData": {
            "type": "object",
            "description": "이벤트의 participationType=FORM일 때 필수. 이벤트에 정의된 formFields 각 필드명을 key로 하는 비어 있지 않은 문자열 값 객체(예: {\"회사명\": \"..\", \"요청사항\": \"..\"}). 필수 필드가 누락되면 VALIDATION_ERROR로 거부된다."
          }
        }
      },
      "EntryListItem": {
        "allOf": [
          { "$ref": "#/components/schemas/Entry" },
          {
            "type": "object",
            "properties": {
              "user": {
                "allOf": [{ "$ref": "#/components/schemas/User" }],
                "nullable": true,
                "description": "회원 참여 건인 경우 회원 정보(비회원이면 null)"
              }
            }
          }
        ]
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "companyName", "name", "phone"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "원문 비밀번호, 최소 8자 이상(서버가 bcrypt로 해시하여 저장)"
          },
          "companyName": { "type": "string" },
          "name": { "type": "string" },
          "phone": { "type": "string", "example": "010-1234-5678" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string", "description": "JWT Access Token(만료 1시간)" },
          "refreshToken": { "type": "string", "description": "JWT Refresh Token(만료 14일)" }
        }
      },
      "LoginResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/TokenPair" },
          {
            "type": "object",
            "properties": {
              "user": { "$ref": "#/components/schemas/User" }
            }
          }
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string", "description": "폐기할 Refresh Token" }
        }
      },
      "UpdateConsentNoteRequest": {
        "type": "object",
        "required": ["consentNote"],
        "properties": {
          "consentNote": {
            "type": "string",
            "description": "관리자가 참여신청 건별로 사후 작성하는 개인정보 동의 보유 내용(FR-2.4). 재작성 시 값을 덮어쓰며 이력은 남기지 않는다."
          }
        }
      },
      "MyEntry": {
        "type": "object",
        "description": "마이페이지 참여 내역 1건. 회원/비회원 구분·개인정보 필드는 본인 것이라 응답에 포함하지 않는다.",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "format": "uuid" },
          "consentedAt": { "type": "string", "format": "date-time" },
          "status": { "$ref": "#/components/schemas/EntryStatus" },
          "prizeId": { "type": "string", "format": "uuid", "nullable": true },
          "prize": {
            "allOf": [{ "$ref": "#/components/schemas/Prize" }],
            "nullable": true,
            "description": "룰렛 게임형 확정 결과의 경품 상세. 그 외 참여 방식은 null."
          },
          "appliedAt": { "type": "string", "format": "date-time" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "required": ["companyName", "name", "phone"],
        "properties": {
          "companyName": { "type": "string" },
          "name": { "type": "string" },
          "phone": { "type": "string", "example": "010-1234-5678" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": { "type": "string", "format": "password" },
          "newPassword": { "type": "string", "format": "password", "minLength": 8 }
        }
      },
      "ChangePasswordResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": true }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입(일반 참여자)",
        "description": "일반 참여자 계정을 생성한다(FR-1.1). 관리자 계정은 이 API로 생성되지 않는다(도메인 1절, 시딩으로만 생성). role은 서버가 MEMBER로 고정한다. email은 trim+소문자로 정규화한 값 기준으로 중복 검사한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/User" } }
            }
          },
          "400": {
            "description": "입력값 검증 실패(이메일 형식 오류, 비밀번호 8자 미만, 이미 가입된 이메일)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인(관리자·일반 참여자 공통)",
        "description": "이메일/비밀번호로 로그인하여 Access/Refresh Token을 응답 바디로 발급받는다(FR-1.2). 쿠키(Set-Cookie)를 사용하지 않는다. 15분당 IP당 10회로 rate limit이 적용된다(FR-2.5).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } }
            }
          },
          "401": {
