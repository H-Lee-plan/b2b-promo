        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "entryId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateConsentNoteRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "작성/수정 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Entry" } } }
          },
          "400": {
            "description": "consentNote가 문자열이 아님(VALIDATION_ERROR)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자(role=ADMIN)가 아닌 사용자의 접근",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않는 참여신청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/events/{eventId}/entries/export": {
      "get": {
        "tags": ["Entries"],
        "summary": "참여신청 명단 CSV 다운로드 (관리자 전용)",
        "description": "관리자(role=ADMIN) 전용. 이벤트별 참여신청 전체를 CSV로 변환해 반환한다(FR-2.6). 항목은 목록 조회(GET /events/{eventId}/entries)와 동일하게 구분/업체명/담당자/이메일/동의시각/경품/상태 순이며, 스트리밍·페이지네이션 없이 한 번에 생성한다. 한글이 엑셀에서 깨지지 않도록 UTF-8 BOM을 선행 바이트로 포함한다.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "다운로드 성공(0건이어도 헤더 행만 있는 CSV 반환)",
            "headers": {
              "Content-Disposition": {
                "description": "attachment; filename=\"entries-{eventId}.csv\"",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "text/csv": { "schema": { "type": "string", "format": "binary" } }
            }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "403": {
            "description": "관리자(role=ADMIN)가 아닌 사용자의 접근",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않는 이벤트",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/mypage/entries": {
      "get": {
        "tags": ["Mypage"],
        "summary": "본인 참여 내역 조회",
        "description": "로그인 회원 본인의 참여신청 목록을 신청 시각 순으로 조회한다(FR-2.1). 당첨 결과(status/prize)를 포함한다.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "조회 성공(0건이어도 200 + 빈 배열)",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MyEntry" } }
              }
            }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/mypage/entries/{entryId}/cancel": {
      "post": {
        "tags": ["Mypage"],
        "summary": "본인 참여신청 취소",
        "description": "로그인 회원 본인의 참여신청을 취소한다(FR-2.2). 진행중 상태의 단순 참여형/폼 제출형만 취소 가능하다. **룰렛 게임형은 도메인 6절에 따라 항상 거부**된다(엔드포인트 자체는 존재하되 항상 거부). 취소 후 재신청은 이 이벤트에 다시 참여신청을 생성하면 되며, 새 레코드 없이 같은 레코드가 APPLIED로 전환된다(POST /events/{eventId}/entries와 동일 규칙).",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "entryId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "취소 성공",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MyEntry" } } }
          },
          "400": {
            "description": "룰렛 게임형 참여신청이라 취소 불가, 또는 이미 취소/당첨/미당첨 등 취소 가능한 상태가 아님(VALIDATION_ERROR)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": {
            "description": "인증 토큰 없음/유효하지 않음",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "404": {
            "description": "존재하지 않거나 본인 소유가 아닌 참여신청",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "409": {
            "description": "이미 종료된 이벤트의 참여신청 취소 시도(EVENT_CLOSED)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": {
            "description": "서버 내부 오류",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
