        "parameters": [
          { "name": "eventId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/EntryCreateRequest" } }
          }
        },
        "responses": {
          "201": {
            "description": "참여신청 성공(단순 참여는 status=APPLIED, 룰렛 게임형은 status=WON/LOST와 확정 경품 포함)",
